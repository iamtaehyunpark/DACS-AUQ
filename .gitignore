# ---- heavy experiment outputs: kept on the server, NEVER pushed --------------
# react_validation/result/ is ~34G of raw run logs, probe records and judge output;
# v1/data/ is ~326M. The generated tables/figures that summarise them ARE tracked
# (react_validation/reports/, react_validation/figures/).
react_validation/result/
v1/data/
react_validation/analysis/*.jsonl
react_validation/src/*.jsonl
*.jsonl.gz

# per-run scratch state (regenerated by the harness, meaningless off-machine)
react_validation/src/.last_parallel_seed
react_validation/rerun_tasks_llama.txt
react_validation/**/*.w[0-9].jsonl

# pre-"expert update" safety copy of the four uncommitted src files; superseded
# now that those edits are committed
.server_backup_preexpert/

# --- flattened layout (react_validation/* moved up into the repo root, 2026-08-05) ---
# The old react_validation/-prefixed rules above are kept so a checkout of the previous
# layout still ignores correctly. These are their root-level equivalents; without them
# `git add -A` would try to commit ~76G of result/ plus data/ and runs/.
/result/
/data/
/runs/
/viz/*.html
**/__pycache__/
**/_prompt.txt
/analysis/*.jsonl
/src/*.jsonl
/src/.last_parallel_seed
/rerun_tasks_llama.txt
**/*.w[0-9].jsonl
/ReAct/

# one-off operational scratch scripts, not part of the research code
gate_and_queue.sh
queue_new_arms.sh
verify_models.sh
llama_when_free.sh
