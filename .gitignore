# python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# local scratch
scratch/
.DS_Store
*.log

# local inspection doc — not published (contains infra details)
HANDOFF.md

# npm / claude-code artifacts — not part of the research repo
node_modules/
.claude/

# upstream ReAct clone — reference-only, never imported/edited (build-fresh policy)
/ReAct/

# ---- heavy experiment outputs: kept on the server, NEVER pushed --------------
# /result/ is ~76G of raw run logs, probe records and judge output; /data/ ~1G;
# /runs/ ~1.7G. The generated tables and figures that summarise them ARE tracked
# (/reports/, /figures/).
#
# Leading slashes are load-bearing: an unanchored `data/` matches a directory of
# that name at ANY depth, which silently excludes src/data/ and drops the
# HotpotQA dataset file from the repo.
/result/
/data/
/runs/
/viz/*.html
/analysis/*.jsonl
/src/*.jsonl
*.jsonl.gz

# gate-1 replay intermediates: 1240 shard files / 17M, regenerated by
# analysis/gate1_replay_*.py. The assembled labels and tables ARE tracked.
/reports/gate1/replay_shards/

# per-run scratch state (regenerated by the harness, meaningless off-machine)
/src/.last_parallel_seed
/rerun_tasks_llama.txt
**/*.w[0-9].jsonl
**/_prompt.txt

# one-off operational scratch scripts, not part of the research code
/gate_and_queue.sh
/queue_new_arms.sh
/verify_models.sh
/llama_when_free.sh
/stop_27b.sh
